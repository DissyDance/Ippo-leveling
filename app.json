{
  "expo": {
    "name": "Ippo Leveling",
    "slug": "ippo-leveling",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ippoleveling",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050308",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dissydance.ippoleveling"
    },
    "android": {
      "package": "com.dissydance.ippoleveling",
      "adaptiveIcon": {
        "backgroundColor": "#050308",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050308",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#050308"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
